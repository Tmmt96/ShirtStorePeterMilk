@model ShirtStore.Domain.Entities.Cart
@{
    ViewData["Title"] = "Carrinho";
    ViewData["Description"] = "Consulta os artigos escolhidos no teu carrinho Peter Milk.";
    ViewData["NoIndex"] = true;
}

<h1>Carrinho</h1>

@if (TempData["CartError"] is string cartError)
{
    <div class="cart-message" role="alert">
        <span>@cartError</span>
    </div>
}

@if (!Model.Items.Any())
{
    <p class="cart-empty">O teu carrinho está vazio. <a href="/catalog">Ver catálogo</a></p>
    return;
}

<div class="cart-table-wrap">
<table class="cart-table">
    <thead>
        <tr>
            <th>Produto</th>
            <th>Variante</th>
            <th>Preço</th>
            <th>Qtd</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td data-label="Produto">@item.Product.Name</td>
            <td data-label="Variante">@item.Variant.Size / @item.Variant.Color</td>
            <td data-label="Preço">@item.UnitPrice.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</td>
            <td data-label="Quantidade">
                <form method="post" action="/cart/update/@item.Id" class="cart-quantity-form">
                    @Html.AntiForgeryToken()
                    <label class="sr-only" for="quantity-@item.Id">Quantidade de @item.Product.Name</label>
                    <input id="quantity-@item.Id" name="quantity" type="number" min="1" max="@item.Variant.AvailableStock" value="@item.Quantity" />
                    <button type="submit" class="sr-only">Actualizar quantidade</button>
                </form>
            </td>
            <td data-label="Total">@((item.UnitPrice * item.Quantity).ToString("C", CultureInfo.GetCultureInfo("pt-PT")))</td>
            <td data-label="">
                <form method="post" action="/cart/remove/@item.Id" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-remove" aria-label="Remover @item.Product.Name">✕</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@{
    var subTotal = Model.Items.Sum(i => i.UnitPrice * i.Quantity);
    var shipping = subTotal >= 50 ? 0 : 4.99m;
    var total    = subTotal + shipping;
}
<div class="cart-summary">
    <p>Subtotal: <strong>@subTotal.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</strong></p>
    <p>Portes: <strong>@(shipping == 0 ? "Grátis" : shipping.ToString("C", CultureInfo.GetCultureInfo("pt-PT")))</strong></p>
    <p class="total">Total: <strong>@total.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</strong></p>
</div>

<a href="/checkout" class="btn btn-primary btn-checkout">Finalizar Compra</a>

@section Scripts {
    <script>
        (() => {
            document.querySelectorAll('.cart-quantity-form').forEach(form => {
                const input = form.querySelector('input[name="quantity"]');
                if (!input) return;

                let submittedValue = input.value;
                input.addEventListener('change', () => {
                    if (input.value === submittedValue || !input.checkValidity()) return;

                    submittedValue = input.value;
                    input.readOnly = true;
                    form.classList.add('is-updating');
                    form.setAttribute('aria-busy', 'true');
                    form.requestSubmit();
                });
            });

        })();
    </script>
}
