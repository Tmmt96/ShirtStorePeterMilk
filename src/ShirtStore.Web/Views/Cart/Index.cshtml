@model ShirtStore.Domain.Entities.Cart
@{
    ViewData["Title"] = "Carrinho";
    ViewData["Description"] = "Consulta os artigos escolhidos no teu carrinho Peter Milk.";
    ViewData["NoIndex"] = true;
}

<h1>Carrinho</h1>

@if (TempData["CartError"] is string cartError)
{
    <div class="cart-message" role="alert">
        <span>@cartError</span>
    </div>
}

@if (!Model.Items.Any())
{
    <p class="cart-empty">O teu carrinho está vazio. <a href="/catalog">Ver catálogo</a></p>
    return;
}

<div class="cart-table-wrap">
    <table class="cart-table">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Variante</th>
                <th>Preço</th>
                <th>Qtd</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td data-label="Produto">@item.Product.Name</td>
                    <td data-label="Variante">@item.Variant.Size / @item.Variant.Color</td>
                    <td data-label="Preço">@item.UnitPrice.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</td>
                    <td data-label="Quantidade">
                        <form method="post" action="/cart/update/@item.Id" class="cart-quantity-form">
                            @Html.AntiForgeryToken()
                            <label class="sr-only" for="quantity-@item.Id">Quantidade de @item.Product.Name</label>
                            <input id="quantity-@item.Id" name="quantity" type="number" min="1"
                                   max="@item.Variant.AvailableStock" value="@item.Quantity" />
                            <button type="submit" class="sr-only">Actualizar quantidade</button>
                        </form>
                    </td>
                    <td data-label="Total">@((item.UnitPrice * item.Quantity).ToString("C",
                                            CultureInfo.GetCultureInfo("pt-PT")))</td>
                        <td data-label="">
                            <form method="post" action="/cart/remove/@item.Id" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-remove" aria-label="Remover @item.Product.Name">✕</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @{
        var subTotal = Model.Items.Sum(i => i.UnitPrice * i.Quantity);
        var shipping = subTotal >= 50 ? 0 : 4.99m;
        var total = subTotal + shipping;
    }
    <div class="cart-summary">
        <p>Subtotal: <strong>@subTotal.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</strong></p>
        <p>Portes: <strong>@(shipping == 0 ? "Grátis" : shipping.ToString("C",
                        CultureInfo.GetCultureInfo("pt-PT")))</strong></p>
            <p class="total">Total: <strong>@total.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</strong></p>
        </div>

        <a href="/checkout" class="btn btn-primary btn-checkout">Finalizar Compra</a>

        @section Scripts {
            <script>
                (() => {
                    const bindQuantityForms = () => {
                        document.querySelectorAll('.cart-quantity-form').forEach(form => {
                            if (form.dataset.bound === 'true') return;
                            form.dataset.bound = 'true';

                            const input = form.querySelector('input[name="quantity"]');
                            if (!input) return;

                            const updateQuantity = async () => {
                                if (form.dataset.updating === 'true' || !input.checkValidity()) return;

                                form.dataset.updating = 'true';
                                input.readOnly = true;
                                form.classList.add('is-updating');
                                form.setAttribute('aria-busy', 'true');
                                const scrollY = window.scrollY;

                                try {
                                    const response = await fetch(form.action, {
                                        method: 'POST',
                                        body: new FormData(form),
                                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                                    });
                                    if (!response.ok) throw new Error(`Cart update failed: ${response.status}`);

                                    const html = await response.text();
                                    const nextDocument = new DOMParser().parseFromString(html, 'text/html');
                                    const nextTable = nextDocument.querySelector('.cart-table-wrap');
                                    const nextSummary = nextDocument.querySelector('.cart-summary');
                                    const currentTable = document.querySelector('.cart-table-wrap');
                                    const currentSummary = document.querySelector('.cart-summary');

                                    if (!nextTable || !nextSummary || !currentTable || !currentSummary) {
                                        throw new Error('Cart response did not contain the expected sections.');
                                    }

                                    currentTable.replaceWith(nextTable);
                                    currentSummary.replaceWith(nextSummary);

                                    const nextCartLink = nextDocument.querySelector('.cart-link');
                                    const currentCartLink = document.querySelector('.cart-link');
                                    if (nextCartLink && currentCartLink) currentCartLink.replaceWith(nextCartLink);

                                    bindQuantityForms();
                                    window.scrollTo(0, scrollY);
                                } catch (error) {
                                    console.error(error);
                                    input.readOnly = false;
                                    form.dataset.updating = 'false';
                                    form.classList.remove('is-updating');
                                    form.removeAttribute('aria-busy');
                                }
                            };

                            form.addEventListener('submit', event => {
                                event.preventDefault();
                                updateQuantity();
                            });
                            input.addEventListener('change', updateQuantity);
                        });
                    };

                    bindQuantityForms();

                })();
            </script>
        }
